{
    "name": "larena/search",
    "description": "Larena Search: Search and indexing layer for access-aware discovery across storage records, content, documentation, file metadata, file-manager views, REST/MCP contexts and future package-defined sources.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rim Zabarov",
            "homepage": "https://github.com/zabarov"
        }
    ],
    "require": {
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "larena/access": "dev-main",
        "larena/admin": "dev-main",
        "larena/audit": "dev-main",
        "larena/queue": "dev-main",
        "larena/scheduler": "dev-main",
        "larena/ui": "dev-main",
        "php": "^8.3"
    },
    "repositories": [
        {"type": "path", "url": "../access", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../audit", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../admin", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../queue", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../scheduler", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../core", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../cockpit", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../licensing", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../layout", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../link", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../storage", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../property", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../update", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../ui", "options": {"symlink": true, "reference": "auto"}},
        {"type": "path", "url": "../dataview", "options": {"symlink": true, "reference": "auto"}}
    ],
    "autoload": {
        "psr-4": {
            "Larena\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larena\\Search\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larena\\Search\\Providers\\SearchServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": [
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchContractTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchFailsClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/InMemorySearchRuntimeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/InMemorySearchRuntimeFailsClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/DatabaseSearchIndexTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchSourceRegistryTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchReindexServiceTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchLaravelPackageContractTest.php"
            ,"php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PublicSearchPresentationTest.php"
            ,"php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SearchQueueResumeIntegrationTest.php"
        ],
        "test:unit": [
            "@test"
        ],
        "lint": "php scripts/lint.php",
        "analyse": "php scripts/analyse.php",
        "validate:larena": "php scripts/validate-larena-package.php",
        "evidence:check": "php scripts/check-evidence.php",
        "scope:check": "php tools/larena-scope-check.php",
        "quality:gate": [
            "@validate:larena",
            "@lint",
            "@analyse",
            "@test",
            "@larena:metadata:check",
            "@evidence:check",
            "@scope:check"
        ],
        "larena:metadata:check": "php scripts/check-metadata-sync.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.31"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
